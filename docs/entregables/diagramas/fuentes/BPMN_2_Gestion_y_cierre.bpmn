<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P2" targetNamespace="http://mallplaza-copiapo/incidencias">
  <bpmn:collaboration id="Collab_P2">
    <bpmn:participant id="Pool_P2" name="Gestión y cierre" processRef="Process_P2"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_P2" name="Gestión y cierre de incidencias" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P2">
      <bpmn:lane id="Lane_P2_jef" name="Jefatura"><bpmn:flowNodeRef>P2_inicio</bpmn:flowNodeRef><bpmn:flowNodeRef>P2_auth</bpmn:flowNodeRef><bpmn:flowNodeRef>P2_cola</bpmn:flowNodeRef><bpmn:flowNodeRef>P2_gf</bpmn:flowNodeRef><bpmn:flowNodeRef>P2_filtro</bpmn:flowNodeRef><bpmn:flowNodeRef>P2_det</bpmn:flowNodeRef><bpmn:flowNodeRef>P2_cambiar</bpmn:flowNodeRef><bpmn:flowNodeRef>P2_trab</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_P2_sis" name="Sistema"><bpmn:flowNodeRef>P2_cambio</bpmn:flowNodeRef><bpmn:flowNodeRef>P2_gv</bpmn:flowNodeRef><bpmn:flowNodeRef>P2_gr</bpmn:flowNodeRef><bpmn:flowNodeRef>P2_kpi</bpmn:flowNodeRef><bpmn:flowNodeRef>P2_fin</bpmn:flowNodeRef><bpmn:flowNodeRef>P2_rech</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_inicio" name="Incidencia pendiente en la cola"/>
    <bpmn:subProcess id="P2_auth" name="Iniciar sesión">
      <bpmn:startEvent id="a_s" name=""/>
      <bpmn:task id="a_1" name="Ingresar correo y contraseña"/>
      <bpmn:task id="a_2" name="Validar credenciales y límite de intentos"/>
      <bpmn:exclusiveGateway id="a_g" name="¿Credenciales válidas?"/>
      <bpmn:task id="a_3" name="Crear la sesión con cookie protegida"/>
      <bpmn:endEvent id="a_e1" name="Sesión activa"/>
      <bpmn:task id="a_4" name="Informar un error genérico"/>
      <bpmn:endEvent id="a_e2" name="Acceso denegado"/>
      <bpmn:sequenceFlow id="F_SP_auth_0" sourceRef="a_s" targetRef="a_1"/>
      <bpmn:sequenceFlow id="F_SP_auth_1" sourceRef="a_1" targetRef="a_2"/>
      <bpmn:sequenceFlow id="F_SP_auth_2" sourceRef="a_2" targetRef="a_g"/>
      <bpmn:sequenceFlow id="F_SP_auth_3" name="Sí" sourceRef="a_g" targetRef="a_3"/>
      <bpmn:sequenceFlow id="F_SP_auth_4" sourceRef="a_3" targetRef="a_e1"/>
      <bpmn:sequenceFlow id="F_SP_auth_5" name="No" sourceRef="a_g" targetRef="a_4"/>
      <bpmn:sequenceFlow id="F_SP_auth_6" sourceRef="a_4" targetRef="a_e2"/>
    </bpmn:subProcess>
    <bpmn:task id="P2_cola" name="Consultar la cola priorizada"/>
    <bpmn:exclusiveGateway id="P2_gf" name="¿Necesita acotar la lista?"/>
    <bpmn:subProcess id="P2_filtro" name="Filtrar y buscar incidencias">
      <bpmn:startEvent id="f_s" name=""/>
      <bpmn:task id="f_1" name="Elegir filtros o ingresar el número de incidencia"/>
      <bpmn:task id="f_2" name="Validar los criterios"/>
      <bpmn:exclusiveGateway id="f_g" name="¿Criterios válidos?"/>
      <bpmn:task id="f_3" name="Mostrar coincidencias ordenadas por prioridad"/>
      <bpmn:endEvent id="f_e1" name="Lista filtrada"/>
      <bpmn:task id="f_4" name="Mostrar el mensaje de validación"/>
      <bpmn:endEvent id="f_e2" name="Consulta rechazada"/>
      <bpmn:sequenceFlow id="F_SP_filtro_0" sourceRef="f_s" targetRef="f_1"/>
      <bpmn:sequenceFlow id="F_SP_filtro_1" sourceRef="f_1" targetRef="f_2"/>
      <bpmn:sequenceFlow id="F_SP_filtro_2" sourceRef="f_2" targetRef="f_g"/>
      <bpmn:sequenceFlow id="F_SP_filtro_3" name="Sí" sourceRef="f_g" targetRef="f_3"/>
      <bpmn:sequenceFlow id="F_SP_filtro_4" sourceRef="f_3" targetRef="f_e1"/>
      <bpmn:sequenceFlow id="F_SP_filtro_5" name="No" sourceRef="f_g" targetRef="f_4"/>
      <bpmn:sequenceFlow id="F_SP_filtro_6" sourceRef="f_4" targetRef="f_e2"/>
    </bpmn:subProcess>
    <bpmn:task id="P2_det" name="Revisar detalle e historial"/>
    <bpmn:task id="P2_cambiar" name="Cambiar el estado de la incidencia"/>
    <bpmn:task id="P2_trab" name="Atender la falla en terreno (fuera del sistema)"/>
    <bpmn:subProcess id="P2_cambio" name="Validar y registrar el cambio">
      <bpmn:startEvent id="s_s" name=""/>
      <bpmn:task id="s_1" name="Verificar la sesión de Jefatura"/>
      <bpmn:exclusiveGateway id="s_g" name="¿Transición permitida?"/>
      <bpmn:task id="s_2" name="Actualizar estado y fechas de inicio o cierre"/>
      <bpmn:task id="s_3" name="Registrar la entrada en el historial"/>
      <bpmn:endEvent id="s_e1" name="Cambio aplicado"/>
      <bpmn:endEvent id="s_e2" name="Cambio rechazado"/>
      <bpmn:sequenceFlow id="F_SP_cambio_0" sourceRef="s_s" targetRef="s_1"/>
      <bpmn:sequenceFlow id="F_SP_cambio_1" sourceRef="s_1" targetRef="s_g"/>
      <bpmn:sequenceFlow id="F_SP_cambio_2" name="Sí" sourceRef="s_g" targetRef="s_2"/>
      <bpmn:sequenceFlow id="F_SP_cambio_3" sourceRef="s_2" targetRef="s_3"/>
      <bpmn:sequenceFlow id="F_SP_cambio_4" sourceRef="s_3" targetRef="s_e1"/>
      <bpmn:sequenceFlow id="F_SP_cambio_5" name="No" sourceRef="s_g" targetRef="s_e2"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="P2_gv" name="¿Cambio válido?"/>
    <bpmn:exclusiveGateway id="P2_gr" name="¿Quedó Resuelta?"/>
    <bpmn:task id="P2_kpi" name="Actualizar los indicadores del dashboard"/>
    <bpmn:endEvent id="P2_fin" name="Incidencia cerrada"/>
    <bpmn:endEvent id="P2_rech" name="Cambio rechazado"/>
    <bpmn:sequenceFlow id="P2_f1" sourceRef="P2_inicio" targetRef="P2_auth"/>
    <bpmn:sequenceFlow id="P2_f2" sourceRef="P2_auth" targetRef="P2_cola"/>
    <bpmn:sequenceFlow id="P2_f3" sourceRef="P2_cola" targetRef="P2_gf"/>
    <bpmn:sequenceFlow id="P2_f4" name="Sí" sourceRef="P2_gf" targetRef="P2_filtro"/>
    <bpmn:sequenceFlow id="P2_f5" name="No" sourceRef="P2_gf" targetRef="P2_det"/>
    <bpmn:sequenceFlow id="P2_f6" sourceRef="P2_filtro" targetRef="P2_det"/>
    <bpmn:sequenceFlow id="P2_f7" sourceRef="P2_det" targetRef="P2_cambiar"/>
    <bpmn:sequenceFlow id="P2_f8" sourceRef="P2_cambiar" targetRef="P2_cambio"/>
    <bpmn:sequenceFlow id="P2_f9" sourceRef="P2_cambio" targetRef="P2_gv"/>
    <bpmn:sequenceFlow id="P2_f10" name="Sí" sourceRef="P2_gv" targetRef="P2_gr"/>
    <bpmn:sequenceFlow id="P2_f11" name="No" sourceRef="P2_gv" targetRef="P2_rech"/>
    <bpmn:sequenceFlow id="P2_f12" name="Sí" sourceRef="P2_gr" targetRef="P2_kpi"/>
    <bpmn:sequenceFlow id="P2_f13" sourceRef="P2_kpi" targetRef="P2_fin"/>
    <bpmn:sequenceFlow id="P2_f14" name="No" sourceRef="P2_gr" targetRef="P2_trab"/>
    <bpmn:sequenceFlow id="P2_f15" sourceRef="P2_trab" targetRef="P2_cambiar"/>
  </bpmn:process>
