<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P1" targetNamespace="http://mallplaza-copiapo/incidencias">
  <bpmn:collaboration id="Collab_P1">
    <bpmn:participant id="Pool_P1" name="Reporte y priorización" processRef="Process_P1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_P1" name="Reporte y priorización de incidencias" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P1">
      <bpmn:lane id="Lane_P1_op" name="Operario"><bpmn:flowNodeRef>P1_inicio</bpmn:flowNodeRef><bpmn:flowNodeRef>P1_qr</bpmn:flowNodeRef><bpmn:flowNodeRef>P1_completar</bpmn:flowNodeRef><bpmn:flowNodeRef>P1_corregir</bpmn:flowNodeRef><bpmn:flowNodeRef>P1_fin</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_P1_sis" name="Sistema"><bpmn:flowNodeRef>P1_validar</bpmn:flowNodeRef><bpmn:flowNodeRef>P1_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>P1_prio</bpmn:flowNodeRef><bpmn:flowNodeRef>P1_reg</bpmn:flowNodeRef><bpmn:flowNodeRef>P1_conf</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1_inicio" name="Falla detectada"/>
    <bpmn:task id="P1_qr" name="Escanear el QR y abrir el formulario"/>
    <bpmn:subProcess id="P1_completar" name="Completar y enviar reporte">
      <bpmn:startEvent id="c_s" name=""/>
      <bpmn:task id="c_1" name="Ingresar el RUT"/>
      <bpmn:task id="c_2" name="Seleccionar ubicación y tipo de falla"/>
      <bpmn:task id="c_3" name="Indicar impacto operativo, riesgo y terceros"/>
      <bpmn:exclusiveGateway id="c_g" name="¿Agregar comentario o fotos?"/>
      <bpmn:task id="c_4" name="Escribir comentario y adjuntar de 1 a 3 fotos"/>
      <bpmn:task id="c_5" name="Enviar el formulario"/>
      <bpmn:endEvent id="c_e" name="Reporte enviado"/>
      <bpmn:sequenceFlow id="F_SP_completar_0" sourceRef="c_s" targetRef="c_1"/>
      <bpmn:sequenceFlow id="F_SP_completar_1" sourceRef="c_1" targetRef="c_2"/>
      <bpmn:sequenceFlow id="F_SP_completar_2" sourceRef="c_2" targetRef="c_3"/>
      <bpmn:sequenceFlow id="F_SP_completar_3" sourceRef="c_3" targetRef="c_g"/>
      <bpmn:sequenceFlow id="F_SP_completar_4" name="Sí" sourceRef="c_g" targetRef="c_4"/>
      <bpmn:sequenceFlow id="F_SP_completar_5" name="No" sourceRef="c_g" targetRef="c_5"/>
      <bpmn:sequenceFlow id="F_SP_completar_6" sourceRef="c_4" targetRef="c_5"/>
      <bpmn:sequenceFlow id="F_SP_completar_7" sourceRef="c_5" targetRef="c_e"/>
    </bpmn:subProcess>
    <bpmn:task id="P1_corregir" name="Corregir los datos indicados"/>
    <bpmn:endEvent id="P1_fin" name="Reporte confirmado"/>
    <bpmn:subProcess id="P1_validar" name="Validar reporte">
      <bpmn:startEvent id="v_s" name=""/>
      <bpmn:task id="v_1" name="Aplicar el límite de envíos por origen"/>
      <bpmn:task id="v_2" name="Verificar los campos obligatorios"/>
      <bpmn:task id="v_3" name="Validar el RUT con módulo 11"/>
      <bpmn:task id="v_4" name="Validar los valores contra los catálogos"/>
      <bpmn:exclusiveGateway id="v_g" name="¿Todo correcto?"/>
      <bpmn:endEvent id="v_e1" name="Reporte válido"/>
      <bpmn:endEvent id="v_e2" name="Reporte inválido"/>
      <bpmn:sequenceFlow id="F_SP_validar_0" sourceRef="v_s" targetRef="v_1"/>
      <bpmn:sequenceFlow id="F_SP_validar_1" sourceRef="v_1" targetRef="v_2"/>
      <bpmn:sequenceFlow id="F_SP_validar_2" sourceRef="v_2" targetRef="v_3"/>
      <bpmn:sequenceFlow id="F_SP_validar_3" sourceRef="v_3" targetRef="v_4"/>
      <bpmn:sequenceFlow id="F_SP_validar_4" sourceRef="v_4" targetRef="v_g"/>
      <bpmn:sequenceFlow id="F_SP_validar_5" name="Sí" sourceRef="v_g" targetRef="v_e1"/>
      <bpmn:sequenceFlow id="F_SP_validar_6" name="No" sourceRef="v_g" targetRef="v_e2"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="P1_gw" name="¿Datos válidos?"/>
    <bpmn:subProcess id="P1_prio" name="Calcular prioridad">
      <bpmn:startEvent id="p_s" name=""/>
      <bpmn:exclusiveGateway id="p_g1" name="¿Impacto operativo y alto tránsito?"/>
      <bpmn:exclusiveGateway id="p_g2" name="¿Riesgo de accidente o afecta a terceros?"/>
      <bpmn:exclusiveGateway id="p_g3" name="¿Alto tránsito o impacto operativo?"/>
      <bpmn:task id="p_c" name="Asignar prioridad Crítica"/>
      <bpmn:task id="p_a" name="Asignar prioridad Alta"/>
      <bpmn:task id="p_m" name="Asignar prioridad Media"/>
      <bpmn:task id="p_b" name="Asignar prioridad Baja"/>
      <bpmn:endEvent id="p_e" name="Prioridad asignada"/>
      <bpmn:sequenceFlow id="F_SP_prioridad_0" sourceRef="p_s" targetRef="p_g1"/>
      <bpmn:sequenceFlow id="F_SP_prioridad_1" name="No" sourceRef="p_g1" targetRef="p_g2"/>
      <bpmn:sequenceFlow id="F_SP_prioridad_2" name="No" sourceRef="p_g2" targetRef="p_g3"/>
      <bpmn:sequenceFlow id="F_SP_prioridad_3" name="No" sourceRef="p_g3" targetRef="p_b"/>
      <bpmn:sequenceFlow id="F_SP_prioridad_4" name="Sí" sourceRef="p_g1" targetRef="p_c"/>
      <bpmn:sequenceFlow id="F_SP_prioridad_5" name="Sí" sourceRef="p_g2" targetRef="p_a"/>
      <bpmn:sequenceFlow id="F_SP_prioridad_6" name="Sí" sourceRef="p_g3" targetRef="p_m"/>
      <bpmn:sequenceFlow id="F_SP_prioridad_7" sourceRef="p_b" targetRef="p_e"/>
      <bpmn:sequenceFlow id="F_SP_prioridad_8" sourceRef="p_c" targetRef="p_e"/>
      <bpmn:sequenceFlow id="F_SP_prioridad_9" sourceRef="p_a" targetRef="p_e"/>
      <bpmn:sequenceFlow id="F_SP_prioridad_10" sourceRef="p_m" targetRef="p_e"/>
    </bpmn:subProcess>
    <bpmn:task id="P1_reg" name="Registrar la incidencia (Pendiente, fecha e historial)"/>
    <bpmn:task id="P1_conf" name="Confirmar al operario con número y prioridad"/>
    <bpmn:sequenceFlow id="P1_f1" sourceRef="P1_inicio" targetRef="P1_qr"/>
    <bpmn:sequenceFlow id="P1_f2" sourceRef="P1_qr" targetRef="P1_completar"/>
    <bpmn:sequenceFlow id="P1_f3" sourceRef="P1_completar" targetRef="P1_validar"/>
    <bpmn:sequenceFlow id="P1_f4" sourceRef="P1_validar" targetRef="P1_gw"/>
    <bpmn:sequenceFlow id="P1_f5" name="Sí" sourceRef="P1_gw" targetRef="P1_prio"/>
    <bpmn:sequenceFlow id="P1_f6" sourceRef="P1_prio" targetRef="P1_reg"/>
    <bpmn:sequenceFlow id="P1_f7" sourceRef="P1_reg" targetRef="P1_conf"/>
    <bpmn:sequenceFlow id="P1_f8" sourceRef="P1_conf" targetRef="P1_fin"/>
    <bpmn:sequenceFlow id="P1_f9" name="No" sourceRef="P1_gw" targetRef="P1_corregir"/>
    <bpmn:sequenceFlow id="P1_f10" sourceRef="P1_corregir" targetRef="P1_completar"/>
  </bpmn:process>
